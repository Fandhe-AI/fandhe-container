<?xml version="1.0" encoding="UTF-8"?>
<!--
  TASK-64.6・MAC-1: tests/vm_boot.rs の実機起動テスト専用の entitlements。
  Virtualization.framework で VM を作るバイナリに必要な com.apple.security.virtualization のみを付与する。
  ad-hoc 署名（codesign --sign -）で使う。手順は AGENTS.md「実機前提テスト」節を参照。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.virtualization</key>
    <true/>
</dict>
</plist>
