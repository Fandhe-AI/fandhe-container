# macOS ゲストカーネルの Kconfig フラグメント（arm64 のみ。TASK-64 追補・#1874・MAC-1・#362・#1823）。
#
# 役割: build.sh が `make ARCH=arm64 KCONFIG_ALLCONFIG=<本ファイル> allnoconfig` の入力として使う。
# allnoconfig を基底にするため、ここに書いた記号だけが有効になる最小構成になる。
# build.sh は olddefconfig の後に、本ファイルで =y とした全記号が .config に残ったかを照合し、
# 依存不足で黙って落ちた記号があればビルドを失敗させる（config-option-missing）。
# 各 CONFIG_ 行の直前の `# 理由:` コメントが、その記号を有効にする理由（使うデバイス・試験）。
# 本ファイルは自作で、Kata Containers・apple/containerization の設定行は写していない（#1823 (c)）。
# ライセンス: 本リポジトリの Apache-2.0。ビルド成果物のカーネルは GPL-2.0（guest/kernel/README.md）。

# 理由: すべて組み込みにする。init（#1875）はモジュールをロードせず、initrd（#1878）は init だけを梱包する。
# CONFIG_MODULES is not set

# 理由: カーネルログの出力（vm_boot の起動マーカー判定に使う）。
CONFIG_PRINTK=y
# 理由: コンソール（hvc0）の土台となる TTY 層。
CONFIG_TTY=y
# 理由: init（ELF）の実行。
CONFIG_BINFMT_ELF=y
# 理由: シェルスクリプト形式の起動物の実行。
CONFIG_BINFMT_SCRIPT=y
# 理由: init が /proc を参照する。
CONFIG_PROC_FS=y
# 理由: init が /sys を参照する（virtio デバイスの列挙）。
CONFIG_SYSFS=y
# 理由: /tmp・/run などの tmpfs。
CONFIG_TMPFS=y
# 理由: 一般ユーザーとプロセス管理（uid/gid）。
CONFIG_MULTIUSER=y
# 注: arm64 には ARCH_VIRT が無い（32-bit ARM / RISC-V の記号）。割り込みコントローラ（ARM_GIC_V3）は ARM64 自体が select するため書かない。
# 理由: vm_boot の CPU 数指定（複数 vCPU）に対応する。
CONFIG_SMP=y

# --- コンテナ実行（MAC-4・TASK-191・#2276）---
# 注: cgroup v1（MEMCG_V1・CPUSETS_V1）は入れない（cgroups v2 単独。CORE-4・SEC-6）。CPUSETS・TIME_NS・BPF_SYSCALL・SWAP も使わないため入れない（guest/kernel/README.md）。
# 注: 文字列の記号（CONFIG_LSM）は build.sh の残存照合（=y 行のみ）の対象外のため、build-selftest.sh の静的検査で守る。
# 理由: namespace のメニュー。allnoconfig は EXPERT 配下の既定 y も n にするため明示する（コンテナの分離の土台）。
CONFIG_NAMESPACES=y
# 理由: rootless の user namespace（SEC-5・CORE-6）。default n のため明示する。
CONFIG_USER_NS=y
# 理由: core の CLONE_NEWPID（コンテナごとの PID 空間）。
CONFIG_PID_NS=y
# 理由: core の CLONE_NEWNET（コンテナごとのネットワーク空間）。
CONFIG_NET_NS=y
# 理由: core の CLONE_NEWUTS（hostname の分離）。
CONFIG_UTS_NS=y
# 理由: IPC_NS の依存（SYSVIPC か POSIX_MQUEUE のどちらかが要る）。
CONFIG_SYSVIPC=y
# 理由: OCI 既定の /dev/mqueue と IPC_NS の依存。
CONFIG_POSIX_MQUEUE=y
# 理由: core の CLONE_NEWIPC。
CONFIG_IPC_NS=y
# 理由: cgroup v2 のメニュー（cgroup namespace の CLONE_NEWCGROUP を含む。CORE-4）。
CONFIG_CGROUPS=y
# 理由: memory controller（memory.max。core の set_memory_limits）。
CONFIG_MEMCG=y
# 理由: cpu controller の土台。
CONFIG_CGROUP_SCHED=y
# 理由: cpu.weight。
CONFIG_FAIR_GROUP_SCHED=y
# 理由: cpu.max（default n のため明示する）。
CONFIG_CFS_BANDWIDTH=y
# 理由: pids controller（pids.max）。
CONFIG_CGROUP_PIDS=y
# 理由: io controller の土台（BLOCK 要。#4658 の委譲対象）。
CONFIG_BLK_CGROUP=y
# 理由: io.max（core の cgroups/io_max.rs）。
CONFIG_BLK_DEV_THROTTLING=y
# 理由: io.weight（core の cgroups/io_weight.rs）。
CONFIG_BLK_CGROUP_IOCOST=y
# 理由: seccomp（CORE-5。arm64 の HAVE_ARCH_SECCOMP_FILTER が前提）。
CONFIG_SECCOMP=y
# 理由: seccomp の BPF フィルタと user notification。select で有効になるが、残存照合の対象にするため明示する。
CONFIG_SECCOMP_FILTER=y
# 理由: Landlock の土台（SECURITY_LANDLOCK の依存）。
CONFIG_SECURITY=y
# 理由: Landlock（core は ABI 6 以上を要し、6.18 で満たす。CORE-5・SEC-4）。
CONFIG_SECURITY_LANDLOCK=y
# 理由: Landlock は CONFIG_LSM に名前が無いと起動時に有効にならない。既定にも入るが意図を固定する。
CONFIG_LSM="landlock"

# 理由: FANDHE_CONTAINER_MACOS_VM_INITRD で渡す initramfs を展開する（#1878）。
CONFIG_BLK_DEV_INITRD=y
# 理由: initramfs の圧縮形式は gzip を前提とする（#1878 で変わるなら README とあわせて更新）。
CONFIG_RD_GZIP=y
# 理由: /dev の供給。DEVTMPFS_MOUNT は initramfs 起動には効かないため init が自分で mount する（#1875）。
CONFIG_DEVTMPFS=y
# 理由: rootfs が通常のディスクの場合の自動 mount（initramfs 起動では効かない）。
CONFIG_DEVTMPFS_MOUNT=y

# 理由: virtio 系 transport・DRM_VIRTIO_GPU の前提メニュー。drivers/virtio/Kconfig で default y だが、allnoconfig は default y も n にするため明示する。
CONFIG_VIRTIO_MENU=y
# 理由: Virtualization.framework が arm64 で virtio を PCI と MMIO のどちらで出すかは未確認。両方を有効にする。
CONFIG_PCI=y
# 理由: 同上。汎用 PCI ホストブリッジ。
CONFIG_PCI_HOST_GENERIC=y
# 理由: 同上。virtio-pci。
CONFIG_VIRTIO_PCI=y
# 理由: 同上。virtio-mmio。
CONFIG_VIRTIO_MMIO=y

# 理由: console=hvc0 のコンソール。vm_boot のブートマーカー・起動完了マーカーの受信に使う。
CONFIG_VIRTIO_CONSOLE=y
# 理由: virtio-blk の前提となるブロック層。
CONFIG_BLOCK=y
# 理由: virtio-blk は drivers/block/Kconfig の BLK_DEV メニュー配下で、allnoconfig は BLK_DEV（default y）も n にするため明示する。
CONFIG_BLK_DEV=y
# 理由: FANDHE_CONTAINER_MACOS_VM_DISK_IMAGE のディスクイメージ。
CONFIG_VIRTIO_BLK=y
# 理由: virtio-fs の土台（virtiofs_io のタグ fandhe-io・#1374）。
CONFIG_FUSE_FS=y
# 理由: ホストの共有ディレクトリをゲストへ出す virtio-fs（virtiofs_io・#1374・IO 系）。
CONFIG_VIRTIO_FS=y
# 理由: vsock の前提となるネットワーク層。
CONFIG_NET=y
# 理由: ホストとゲストの制御経路（MAC-1）。
CONFIG_VSOCKETS=y
# 理由: Virtualization.framework の virtio-vsock デバイス。
CONFIG_VIRTIO_VSOCKETS=y
# 理由: virtio-gpu の前提となる DRM 層（GPU-6・poc/vz-custom-virtio-gpu/guest/check-virtio-gpu.sh）。
CONFIG_DRM=y
# 理由: VZCustomVirtioDevice 経由の virtio-gpu（GPU-6）。
CONFIG_DRM_VIRTIO_GPU=y
# 理由: 乱数デバイスの前提。
CONFIG_HW_RANDOM=y
# 理由: VZ のエントロピーデバイス（virtio-rng）。不要と判断したら外し README に理由を書く。
CONFIG_HW_RANDOM_VIRTIO=y
